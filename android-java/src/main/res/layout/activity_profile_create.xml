<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#6200EE"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageButton
                    android:id="@+id/btn_back"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@android:drawable/ic_media_previous"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:tint="#FFFFFF"
                    android:contentDescription="Back" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Create Profile"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:paddingStart="8dp" />

                <Button
                    android:id="@+id/btn_scan_top"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="📷 Scan Doc"
                    android:textColor="#6200EE"
                    android:backgroundTint="#FFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fill once — autofill everywhere"
                android:textColor="#C5CAE9"
                android:textSize="13sp"
                android:paddingTop="6dp"
                android:paddingStart="48dp" />
        </LinearLayout>

        <!-- Profile Tag -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginTop="12dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:elevation="2dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PROFILE TAG"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#6200EE"
                android:letterSpacing="0.1"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/et_profile_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="e.g. Personal, Work, College Application"
                android:textColor="#1A1A2E"
                android:textColorHint="#AAAAAA"
                android:textSize="15sp"
                android:padding="10dp"
                android:background="@android:drawable/edit_text"
                android:inputType="textCapWords" />

        </LinearLayout>

        <!-- SECTION: Personal Info -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="👤  PERSONAL INFORMATION"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#6200EE"
            android:paddingStart="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:elevation="2dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Full Name *" android:textColor="#444" android:textSize="12sp" android:layout_marginBottom="2dp"/>
            <EditText android:id="@+id/et_full_name" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:hint="Your full legal name"
                android:textColor="#1A1A2E" android:textColorHint="#AAAAAA" android:textSize="14sp"
                android:padding="10dp" android:background="@android:drawable/edit_text"
                android:inputType="textPersonName" android:layout_marginBottom="14dp"/>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Father's Name" android:textColor="#444" android:textSize="12sp" android:layout_marginBottom="2dp"/>
            <EditText android:id="@+id/et_father_name" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:hint="Father's full name"
                android:textColor="#1A1A2E" android:textColorHint="#AAAAAA" android:textSize="14sp"
                android:padding="10dp" android:background="@android:drawable/edit_text"
                android:inputType="textPersonName" android:layout_marginBottom="14dp"/>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Mother's Name" android:textColor="#444" android:textSize="12sp" android:layout_marginBottom="2dp"/>
            <EditText android:id="@+id/et_mother_name" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:hint="Mother's full name"
                android:textColor="#1A1A2E" android:textColorHint="#AAAAAA" android:textSize="14sp"
                android:padding="10dp" android:background="@android:drawable/edit_text"
                android:inputType="textPersonName" android:layout_marginBottom="14dp"/>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical" android:layout_marginEnd="8dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Date of Birth" android:textColor="#444" android:textSize="12sp" android:layout_marginBottom="2dp"/>
                    <EditText android:id="@+id/et_dob" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:hint="DD/MM/YYYY"
                        android:textColor="#1A1A2E" android:textColorHint="#AAAAAA" android:textSize="14sp"
                        android:padding="10dp" android:background="@android:drawable/edit_text"
                        android:inputType="date"/>
                </LinearLayout>

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Gender" android:textColor="#444" android:textSize="12sp" android:layout_marginBottom="2dp"/>
                    <EditText android:id="@+id/et_gender" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:hint="Male/Female/Other"
                        android:textColor="#1A1A2E" android:textColorHint="#AAAAAA" android:textSize="14sp"
                        android:padding="10dp" android:background="@android:drawable/edit_text"
                        android:inputType="textCapSentences"/>
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>

        <!-- SECTION: ID Numbers -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🪪  ID NUMBERS"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#6200EE"
            android:paddingStart="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:elevation="2dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Aadhaar Number" android:textColor="#444" android:textSize="12sp" android:layout_marginBottom="2dp"/>
            <EditText android:id="@+id/et_aadhaar" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:hint="XXXX XXXX XXXX"
                android:textColor="#1A1A2E" android:textColorHint="#AAAAAA" android:textSize="14sp"
                android:padding="10dp" android:background="@android:drawable/edit_text"
                android:inputType="number" android:maxLength="14" android:layout_marginBottom="14dp"/>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="PAN Number" android:textColor="#444" android:textSize="12sp" android:layout_marginBottom="2dp"/>
            <EditText android:id="@+id/et_pan" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:hint="ABCDE1234F"
                android:textColor="#1A1A2E" android:textColorHint="#AAAAAA" android:textSize="14sp"
                android:padding="10dp" android:background="@android:drawable/edit_text"
                android:inputType="textCapCharacters" android:maxLength="10" android:layout_marginBottom="14dp"/>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Passport Number" android:textColor="#444" android:textSize="12sp" android:layout_marginBottom="2dp"/>
            <EditText android:id="@+id/et_passport" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:hint="A1234567"
                android:textColor="#1A1A2E" android:textColorHint="#AAAAAA" android:textSize="14sp"
                android:padding="10dp" android:background="@android:drawable/edit_text"
                android:inputType="textCapCharacters"/>

        </LinearLayout>

        <!-- SECTION: Contact -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📞  CONTACT DETAILS"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#6200EE"
            android:paddingStart="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:elevation="2dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Email Address" android:textColor="#444" android:textSize="12sp" android:layout_marginBottom="2dp"/>
            <EditText android:id="@+id/et_email" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:hint="your@email.com"
                android:textColor="#1A1A2E" android:textColorHint="#AAAAAA" android:textSize="14sp"
                android:padding="10dp" android:background="@android:drawable/edit_text"
                android:inputType="textEmailAddress" android:layout_marginBottom="14dp"/>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Mobile Number" android:textColor="#444" android:textSize="12sp" android:layout_marginBottom="2dp"/>
            <EditText android:id="@+id/et_phone" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:hint="+91 9876543210"
                android:textColor="#1A1A2E" android:textColorHint="#AAAAAA" android:textSize="14sp"
                android:padding="10dp" android:background="@android:drawable/edit_text"
                android:inputType="phone" android:layout_marginBottom="14dp"/>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="WhatsApp Number" android:textColor="#444" android:textSize="12sp" android:layout_marginBottom="2dp"/>
            <EditText android:id="@+id/et_whatsapp" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:hint="If different from mobile"
                android:textColor="#1A1A2E" android:textColorHint="#AAAAAA" android:textSize="14sp"
                android:padding="10dp" android:background="@android:drawable/edit_text"
                android:inputType="phone" android:layout_marginBottom="14dp"/>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Alternate Phone" android:textColor="#444" android:textSize="12sp" android:layout_marginBottom="2dp"/>
            <EditText android:id="@+id/et_alt_phone" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:hint="Secondary number"
                android:textColor="#1A1A2E" android:textColorHint="#AAAAAA" android:textSize="14sp"
                android:padding="10dp" android:background="@android:drawable/edit_text"
                android:inputType="phone"/>

        </LinearLayout>

        <!-- SECTION: Address -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🏠  ADDRESS"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#6200EE"
            android:paddingStart="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:elevation="2dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="House / Flat No." android:textColor="#444" android:textSize="12sp" android:layout_marginBottom="2dp"/>
            <EditText android:id="@+id/et_house_no" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:hint="e.g. 42, Block B"
                android:textColor="#1A1A2E" android:textColorHint="#AAAAAA" android:textSize="14sp"
                android:padding="10dp" android:background="@android:drawable/edit_text"
                android:layout_marginBottom="14dp"/>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Street / Colony" android:textColor="#444" android:textSize="12sp" android:layout_marginBottom="2dp"/>
            <EditText android:id="@+id/et_street" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:hint="Street name or colony"
                android:textColor="#1A1A2E" android:textColorHint="#AAAAAA" android:textSize="14sp"
                android:padding="10dp" android:background="@android:drawable/edit_text"
                android:layout_marginBottom="14dp"/>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical" android:layout_marginEnd="8dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="City" android:textColor="#444" android:textSize="12sp" android:layout_marginBottom="2dp"/>
                    <EditText android:id="@+id/et_city" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:hint="City"
                        android:textColor="#1A1A2E" android:textColorHint="#AAAAAA" android:textSize="14sp"
                        android:padding="10dp" android:background="@android:drawable/edit_text"
                        android:inputType="textCapWords"/>
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Pincode" android:textColor="#444" android:textSize="12sp" android:layout_marginBottom="2dp"/>
                    <EditText android:id="@+id/et_pincode" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:hint="110001"
                        android:textColor="#1A1A2E" android:textColorHint="#AAAAAA" android:textSize="14sp"
                        android:padding="10dp" android:background="@android:drawable/edit_text"
                        android:inputType="number" android:maxLength="6"/>
                </LinearLayout>
            </LinearLayout>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="State" android:textColor="#444" android:textSize="12sp"
                android:layout_marginBottom="2dp" android:layout_marginTop="14dp"/>
            <EditText android:id="@+id/et_state" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:hint="State"
                android:textColor="#1A1A2E" android:textColorHint="#AAAAAA" android:textSize="14sp"
                android:padding="10dp" android:background="@android:drawable/edit_text"
                android:inputType="textCapWords" android:layout_marginBottom="14dp"/>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Country" android:textColor="#444" android:textSize="12sp" android:layout_marginBottom="2dp"/>
            <EditText android:id="@+id/et_country" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:hint="India"
                android:textColor="#1A1A2E" android:textColorHint="#AAAAAA" android:textSize="14sp"
                android:padding="10dp" android:background="@android:drawable/edit_text"
                android:inputType="textCapWords"/>

        </LinearLayout>

        <!-- SECTION: Education -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🎓  EDUCATION"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#6200EE"
            android:paddingStart="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:elevation="2dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="School Name" android:textColor="#444" android:textSize="12sp" android:layout_marginBottom="2dp"/>
            <EditText android:id="@+id/et_school" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:hint="High school name"
                android:textColor="#1A1A2E" android:textColorHint="#AAAAAA" android:textSize="14sp"
                android:padding="10dp" android:background="@android:drawable/edit_text"
                android:inputType="textCapWords" android:layout_marginBottom="14dp"/>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical" android:layout_marginEnd="8dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Class 10 %" android:textColor="#444" android:textSize="12sp" android:layout_marginBottom="2dp"/>
                    <EditText android:id="@+id/et_class10_percent" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:hint="e.g. 85.5"
                        android:textColor="#1A1A2E" android:textColorHint="#AAAAAA" android:textSize="14sp"
                        android:padding="10dp" android:background="@android:drawable/edit_text"
                        android:inputType="numberDecimal"/>
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Class 12 %" android:textColor="#444" android:textSize="12sp" android:layout_marginBottom="2dp"/>
                    <EditText android:id="@+id/et_class12_percent" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:hint="e.g. 78.0"
                        android:textColor="#1A1A2E" android:textColorHint="#AAAAAA" android:textSize="14sp"
                        android:padding="10dp" android:background="@android:drawable/edit_text"
                        android:inputType="numberDecimal"/>
                </LinearLayout>
            </LinearLayout>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="College / University" android:textColor="#444" android:textSize="12sp"
                android:layout_marginBottom="2dp" android:layout_marginTop="14dp"/>
            <EditText android:id="@+id/et_college" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:hint="College or university name"
                android:textColor="#1A1A2E" android:textColorHint="#AAAAAA" android:textSize="14sp"
                android:padding="10dp" android:background="@android:drawable/edit_text"
                android:inputType="textCapWords" android:layout_marginBottom="14dp"/>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Degree / Course" android:textColor="#444" android:textSize="12sp" android:layout_marginBottom="2dp"/>
            <EditText android:id="@+id/et_degree" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:hint="e.g. B.Tech, B.Com, MBBS"
                android:textColor="#1A1A2E" android:textColorHint="#AAAAAA" android:textSize="14sp"
                android:padding="10dp" android:background="@android:drawable/edit_text"
                android:inputType="textCapWords" android:layout_marginBottom="14dp"/>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical" android:layout_marginEnd="8dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Branch / Stream" android:textColor="#444" android:textSize="12sp" android:layout_marginBottom="2dp"/>
                    <EditText android:id="@+id/et_branch" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:hint="e.g. CSE, ECE"
                        android:textColor="#1A1A2E" android:textColorHint="#AAAAAA" android:textSize="14sp"
                        android:padding="10dp" android:background="@android:drawable/edit_text"
                        android:inputType="textCapWords"/>
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="CGPA / %" android:textColor="#444" android:textSize="12sp" android:layout_marginBottom="2dp"/>
                    <EditText android:id="@+id/et_cgpa" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:hint="e.g. 8.5"
                        android:textColor="#1A1A2E" android:textColorHint="#AAAAAA" android:textSize="14sp"
                        android:padding="10dp" android:background="@android:drawable/edit_text"
                        android:inputType="numberDecimal"/>
                </LinearLayout>
            </LinearLayout>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Year of Passing" android:textColor="#444" android:textSize="12sp"
                android:layout_marginBottom="2dp" android:layout_marginTop="14dp"/>
            <EditText android:id="@+id/et_pass_year" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:hint="e.g. 2025"
                android:textColor="#1A1A2E" android:textColorHint="#AAAAAA" android:textSize="14sp"
                android:padding="10dp" android:background="@android:drawable/edit_text"
                android:inputType="number" android:maxLength="4"/>

        </LinearLayout>

        <!-- SECTION: Professional -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="💼  PROFESSIONAL"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#6200EE"
            android:paddingStart="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:elevation="2dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Company / Organisation" android:textColor="#444" android:textSize="12sp" android:layout_marginBottom="2dp"/>
            <EditText android:id="@+id/et_company" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:hint="Where you work/worked"
                android:textColor="#1A1A2E" android:textColorHint="#AAAAAA" android:textSize="14sp"
                android:padding="10dp" android:background="@android:drawable/edit_text"
                android:inputType="textCapWords" android:layout_marginBottom="14dp"/>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Designation / Role" android:textColor="#444" android:textSize="12sp" android:layout_marginBottom="2dp"/>
            <EditText android:id="@+id/et_designation" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:hint="e.g. Software Engineer"
                android:textColor="#1A1A2E" android:textColorHint="#AAAAAA" android:textSize="14sp"
                android:padding="10dp" android:background="@android:drawable/edit_text"
                android:inputType="textCapWords" android:layout_marginBottom="14dp"/>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="LinkedIn Profile URL" android:textColor="#444" android:textSize="12sp" android:layout_marginBottom="2dp"/>
            <EditText android:id="@+id/et_linkedin" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:hint="linkedin.com/in/yourname"
                android:textColor="#1A1A2E" android:textColorHint="#AAAAAA" android:textSize="14sp"
                android:padding="10dp" android:background="@android:drawable/edit_text"
                android:inputType="textWebEmailAddress" android:layout_marginBottom="14dp"/>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="GitHub / Portfolio URL" android:textColor="#444" android:textSize="12sp" android:layout_marginBottom="2dp"/>
            <EditText android:id="@+id/et_github" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:hint="github.com/yourname"
                android:textColor="#1A1A2E" android:textColorHint="#AAAAAA" android:textSize="14sp"
                android:padding="10dp" android:background="@android:drawable/edit_text"
                android:inputType="textWebEmailAddress"/>

        </LinearLayout>

        <!-- Save Button -->
        <Button
            android:id="@+id/btn_save_profile"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_margin="16dp"
            android:backgroundTint="#6200EE"
            android:text="✓  Save Profile"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:elevation="4dp" />

    </LinearLayout>
</ScrollView>
