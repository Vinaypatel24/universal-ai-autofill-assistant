<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#6200EE"
    android:gravity="center">

    <!-- Lock Icon -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🔐"
        android:textSize="48sp"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tv_pin_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Enter PIN"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/tv_pin_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Enter your 4-digit PIN to continue"
        android:textColor="#C5CAE9"
        android:textSize="13sp"
        android:layout_marginBottom="40dp" />

    <!-- PIN Dots -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="40dp">

        <View android:id="@+id/dot1" android:layout_width="18dp" android:layout_height="18dp"
            android:layout_margin="10dp" android:background="@drawable/pin_dot_empty" />
        <View android:id="@+id/dot2" android:layout_width="18dp" android:layout_height="18dp"
            android:layout_margin="10dp" android:background="@drawable/pin_dot_empty" />
        <View android:id="@+id/dot3" android:layout_width="18dp" android:layout_height="18dp"
            android:layout_margin="10dp" android:background="@drawable/pin_dot_empty" />
        <View android:id="@+id/dot4" android:layout_width="18dp" android:layout_height="18dp"
            android:layout_margin="10dp" android:background="@drawable/pin_dot_empty" />
    </LinearLayout>

    <!-- Number Pad -->
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginBottom="12dp">
            <Button android:id="@+id/btn1" android:layout_width="72dp" android:layout_height="72dp"
                android:text="1" android:textSize="22sp" android:textColor="#1A1A2E"
                android:backgroundTint="#FFFFFF" android:layout_margin="6dp" />
            <Button android:id="@+id/btn2" android:layout_width="72dp" android:layout_height="72dp"
                android:text="2" android:textSize="22sp" android:textColor="#1A1A2E"
                android:backgroundTint="#FFFFFF" android:layout_margin="6dp" />
            <Button android:id="@+id/btn3" android:layout_width="72dp" android:layout_height="72dp"
                android:text="3" android:textSize="22sp" android:textColor="#1A1A2E"
                android:backgroundTint="#FFFFFF" android:layout_margin="6dp" />
        </LinearLayout>

        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginBottom="12dp">
            <Button android:id="@+id/btn4" android:layout_width="72dp" android:layout_height="72dp"
                android:text="4" android:textSize="22sp" android:textColor="#1A1A2E"
                android:backgroundTint="#FFFFFF" android:layout_margin="6dp" />
            <Button android:id="@+id/btn5" android:layout_width="72dp" android:layout_height="72dp"
                android:text="5" android:textSize="22sp" android:textColor="#1A1A2E"
                android:backgroundTint="#FFFFFF" android:layout_margin="6dp" />
            <Button android:id="@+id/btn6" android:layout_width="72dp" android:layout_height="72dp"
                android:text="6" android:textSize="22sp" android:textColor="#1A1A2E"
                android:backgroundTint="#FFFFFF" android:layout_margin="6dp" />
        </LinearLayout>

        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginBottom="12dp">
            <Button android:id="@+id/btn7" android:layout_width="72dp" android:layout_height="72dp"
                android:text="7" android:textSize="22sp" android:textColor="#1A1A2E"
                android:backgroundTint="#FFFFFF" android:layout_margin="6dp" />
            <Button android:id="@+id/btn8" android:layout_width="72dp" android:layout_height="72dp"
                android:text="8" android:textSize="22sp" android:textColor="#1A1A2E"
                android:backgroundTint="#FFFFFF" android:layout_margin="6dp" />
            <Button android:id="@+id/btn9" android:layout_width="72dp" android:layout_height="72dp"
                android:text="9" android:textSize="22sp" android:textColor="#1A1A2E"
                android:backgroundTint="#FFFFFF" android:layout_margin="6dp" />
        </LinearLayout>

        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button android:id="@+id/btn_clear" android:layout_width="72dp" android:layout_height="72dp"
                android:text="CLR" android:textSize="14sp" android:textColor="#FFFFFF"
                android:backgroundTint="#3700B3" android:layout_margin="6dp" />
            <Button android:id="@+id/btn0" android:layout_width="72dp" android:layout_height="72dp"
                android:text="0" android:textSize="22sp" android:textColor="#1A1A2E"
                android:backgroundTint="#FFFFFF" android:layout_margin="6dp" />
            <Button android:id="@+id/btn_del" android:layout_width="72dp" android:layout_height="72dp"
                android:text="⌫" android:textSize="22sp" android:textColor="#FFFFFF"
                android:backgroundTint="#3700B3" android:layout_margin="6dp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tv_pin_error"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#FF5252"
        android:textSize="13sp"
        android:layout_marginTop="16dp" />

    <Button
        android:id="@+id/btn_skip_pin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Skip PIN (not recommended)"
        android:textColor="#9E9E9E"
        android:background="?android:attr/selectableItemBackground"
        android:textSize="12sp"
        android:layout_marginTop="20dp" />

</LinearLayout>
