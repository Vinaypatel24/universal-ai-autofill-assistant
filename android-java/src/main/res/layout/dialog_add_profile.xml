<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="20dp"
    android:background="@color/surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Create User Profile"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Fill in details to autofill on forms"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btn_scan_document"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:backgroundTint="#EDE7F6"
            android:text="📷 Scan Document (Aadhaar, PAN, Marksheet)"
            android:textColor="@color/primary"
            android:textSize="13sp"
            android:layout_marginBottom="14dp" />

        <EditText
            android:id="@+id/et_profile_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Profile Tag (e.g. Personal, Work, College)"
            android:inputType="textCapWords"
            android:textSize="14sp"
            android:layout_marginBottom="10dp" />

        <EditText
            android:id="@+id/et_full_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Full Name"
            android:inputType="textPersonName"
            android:textSize="14sp"
            android:layout_marginBottom="10dp" />

        <EditText
            android:id="@+id/et_email"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Email Address"
            android:inputType="textEmailAddress"
            android:textSize="14sp"
            android:layout_marginBottom="10dp" />

        <EditText
            android:id="@+id/et_phone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Phone / Mobile Number"
            android:inputType="phone"
            android:textSize="14sp"
            android:layout_marginBottom="10dp" />

        <EditText
            android:id="@+id/et_address"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Residential Address"
            android:inputType="textPostalAddress|textMultiLine"
            android:textSize="14sp"
            android:lines="3"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btn_save_profile"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:backgroundTint="@color/primary"
            android:text="Save Profile"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
