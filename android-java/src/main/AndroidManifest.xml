<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.smartautofiller">

    <!-- Permissions required for Floating Bubble & System-wide Form Filling -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="Universal AI Autofill"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <!-- Splash Launcher Activity -->
        <activity
            android:name=".ui.SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Main Dashboard Activity -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="false" />

        <!-- Feature Tour Onboarding Activity -->
        <activity
            android:name=".ui.OnboardingActivity"
            android:exported="false" />

        <!-- Camera OCR Document Scanner Activity -->
        <activity
            android:name=".ui.CameraActivity"
            android:exported="false" />

        <!-- Core Accessibility Service -->
        <service
            android:name=".service.SmartAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Quick Settings Tile -->
        <service
            android:name=".service.AiFillTileService"
            android:icon="@android:drawable/ic_menu_edit"
            android:label="AI Fill"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Quick Copy Notification Foreground Service -->
        <service
            android:name=".service.QuickCopyService"
            android:exported="false"
            android:foregroundServiceType="specialUse" />

        <!-- 30-Second Secure Clipboard Receiver -->
        <receiver
            android:name=".service.CopyReceiver"
            android:exported="false" />

    </application>
</manifest>
